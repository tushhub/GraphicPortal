@model PortfolioApp.Models.ContactMessage
@{
    ViewData["Title"] = "Contact";
}

@section Styles {
<style>
    .contact-page {
        min-height: 100vh;
        padding: 140px 48px 120px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        max-width: 1200px;
        margin: 0 auto;
        align-items: start;
    }

    .contact-info {
        padding-top: 20px;
    }

    .contact-info h1 {
        font-size: clamp(40px, 5vw, 64px);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.0;
        margin-bottom: 24px;
        opacity: 0;
        transform: translateY(30px);
    }

    .contact-info p {
        font-size: 18px;
        color: #aaaaaa;
        line-height: 1.7;
        margin-bottom: 48px;
        opacity: 0;
        transform: translateY(20px);
    }

    .contact-channels {
        display: flex;
        flex-direction: column;
        gap: 16px;
        opacity: 0;
        transform: translateY(20px);
    }

    .channel-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        text-decoration: none;
        transition: padding-left 0.3s ease;
    }

    .channel-item:hover { padding-left: 8px; }

    .channel-icon {
        width: 40px;
        height: 40px;
        background: rgba(139,92,246,0.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .channel-label {
        font-size: 12px;
        color: #555;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        display: block;
        margin-bottom: 2px;
    }

    .channel-value {
        font-size: 15px;
        color: #ffffff;
        font-weight: 500;
    }

    .contact-form-wrap {
        background: #111111;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        padding: 48px;
        opacity: 0;
        transform: translateY(30px);
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #555;
        margin-bottom: 10px;
    }

    .form-input {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 14px 18px;
        color: #ffffff;
        font-size: 15px;
        font-family: 'Inter', sans-serif;
        transition: border-color 0.3s ease, background 0.3s ease;
        outline: none;
    }

    .form-input:focus {
        border-color: rgba(139,92,246,0.5);
        background: rgba(139,92,246,0.05);
    }

    .form-input::placeholder { color: #444; }

    textarea.form-input {
        resize: vertical;
        min-height: 140px;
    }

    .form-submit {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        border: none;
        border-radius: 40px;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: none;
        transition: opacity 0.3s ease, transform 0.3s ease;
        letter-spacing: 0.02em;
        margin-top: 8px;
    }

    .form-submit:hover { opacity: 0.9; transform: translateY(-2px); }

    .success-msg {
        padding: 16px 20px;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.2);
        border-radius: 8px;
        color: #22c55e;
        font-size: 14px;
        margin-bottom: 24px;
    }

    .validation-error {
        font-size: 12px;
        color: #ef4444;
        margin-top: 6px;
    }

    @@media (max-width: 768px) {
        .contact-page { grid-template-columns: 1fr; padding: 120px 24px 80px; gap: 48px; }
        .contact-form-wrap { padding: 32px 24px; }
    }
</style>
}

<div class="contact-page">
    <!-- LEFT: INFO -->
    <div class="contact-info">
        <h1>Let's build <span class="gradient-text">something great</span> together.</h1>
        <p>Have a project in mind? I'd love to hear about it. Send me a message and I'll get back to you within 24 hours.</p>

        <div class="contact-channels">
            <a href="mailto:hello@alexrivera.design" class="channel-item">
                <div class="channel-icon">✉</div>
                <div>
                    <span class="channel-label">Email</span>
                    <span class="channel-value">hello@@alexrivera.design</span>
                </div>
            </a>
            <a href="#" class="channel-item">
                <div class="channel-icon">in</div>
                <div>
                    <span class="channel-label">LinkedIn</span>
                    <span class="channel-value">linkedin.com/in/alexrivera</span>
                </div>
            </a>
            <a href="#" class="channel-item">
                <div class="channel-icon">𝔹</div>
                <div>
                    <span class="channel-label">Behance</span>
                    <span class="channel-value">behance.net/alexrivera</span>
                </div>
            </a>
            <a href="#" class="channel-item">
                <div class="channel-icon">◎</div>
                <div>
                    <span class="channel-label">Instagram</span>
                    <span class="channel-value">@@alexrivera.design</span>
                </div>
            </a>
        </div>
    </div>

    <!-- RIGHT: FORM -->
    <div class="contact-form-wrap">
        @if (TempData["Success"] != null)
        {
            <div class="success-msg">@TempData["Success"]</div>
        }

        <form asp-action="Index" asp-controller="Contact" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="Name">Your Name</label>
                <input class="form-input" type="text" id="Name" name="Name" placeholder="Jane Smith" value="@Model?.Name" />
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" for="Email">Email Address</label>
                <input class="form-input" type="email" id="Email" name="Email" placeholder="jane@@company.com" value="@Model?.Email" />
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label" for="Message">Tell Me About Your Project</label>
                <textarea class="form-input" id="Message" name="Message" placeholder="I'm looking for help with...">@Model?.Message</textarea>
                <span asp-validation-for="Message" class="validation-error"></span>
            </div>

            <button type="submit" class="form-submit">Send Message →</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    gsap.timeline({ delay: 0.6 })
        .to('.contact-info h1', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
        .to('.contact-info p', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.4')
        .to('.contact-channels', { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.3')
        .to('.contact-form-wrap', { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, '-=0.5');
</script>
}
